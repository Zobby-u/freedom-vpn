<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#0b1220">
<title>Freedom VPN — Country Selector</title>
<style>
:root{color-scheme:dark;--bg:#0b1220;--panel:#121d30;--line:#26354b;--muted:#9fb0c8;--green:#22c55e}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#17314a 0,var(--bg) 55%);font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:#f7fafc;min-height:100vh;padding:24px 14px}
main{max-width:760px;margin:auto}.brand{display:flex;align-items:center;gap:12px;margin:8px 0 26px}.logo{width:48px;height:48px;border-radius:15px;background:#14532d;display:grid;place-items:center;font-size:25px}.brand h1{font-size:23px;margin:0}.brand p{margin:3px 0 0;color:var(--muted);font-size:13px}
.hero,.panel{background:rgba(18,29,48,.94);border:1px solid var(--line);border-radius:22px;padding:22px;margin-bottom:16px}.hero{text-align:center}.shield{font-size:44px}.hero h2{font-size:24px;margin:8px 0}.hero p{color:var(--muted);line-height:1.5;margin:8px auto 0;max-width:520px}
.status{display:inline-flex;gap:8px;align-items:center;border:1px solid #43516a;padding:7px 11px;border-radius:99px;font-size:12px;color:#d6e1ef;margin-top:14px}.dot{width:8px;height:8px;border-radius:50%;background:#f59e0b}
label{display:block;font-weight:650;margin-bottom:9px}.search{width:100%;padding:14px 15px;border-radius:12px;border:1px solid #34445d;background:#0b1424;color:white;font-size:16px;outline:none}.search:focus{border-color:#4ade80}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin:13px 0}.filter{background:#1b2a40;border:1px solid #34445d;color:#dce7f5;padding:8px 12px;border-radius:99px;font-size:13px}.filter.active{background:#14532d;border-color:#22c55e;color:white}
.count{font-size:12px;color:var(--muted);margin:10px 0}.countries{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.country{border:1px solid #2b3a50;background:#101a2a;border-radius:12px;padding:12px;text-align:left;color:white;display:flex;align-items:center;gap:10px;min-width:0}.country.selected{border-color:var(--green);background:#123326}.flag{font-size:24px}.cname{font-size:13px;font-weight:600;overflow-wrap:anywhere}.region{font-size:11px;color:var(--muted);margin-top:3px}.country .tick{margin-left:auto;color:#4ade80;display:none}.country.selected .tick{display:block}
.selectedbox{margin-top:16px;padding:14px;border:1px solid var(--line);border-radius:14px;background:#0c1727}.selectedbox small{color:var(--muted)}.selectedname{font-size:18px;font-weight:700;margin-top:4px}
.connect{width:100%;margin-top:14px;border:0;border-radius:13px;padding:15px;background:#16a34a;color:#fff;font-weight:750;font-size:16px}.connect:active{transform:scale(.99)}.note{color:var(--muted);font-size:12px;line-height:1.5;margin:12px 0 0}.notice{display:none;margin-top:12px;padding:12px;border-radius:12px;background:#382b15;border:1px solid #765a20;color:#fde68a;font-size:13px;line-height:1.5}.foot{text-align:center;color:#8293ab;font-size:12px;padding:8px 0 22px}
@media(min-width:560px){.countries{grid-template-columns:repeat(3,minmax(0,1fr))}.hero,.panel{padding:26px}}
</style></head><body><main>
<header class="brand"><div class="logo">🛡️</div><div><h1>Freedom VPN</h1><p>Your VPN project · country selector demo</p></div></header>
<section class="hero"><div class="shield">🛡️</div><h2>Choose your location</h2><p>Pick a country below. This first version is the website interface; real VPN servers will be connected in a later step.</p><div class="status"><span class="dot"></span><span>VPN server not connected</span></div></section>
<section class="panel"><label for="search">Search countries</label><input id="search" class="search" type="search" placeholder="Type a country name…" autocomplete="off">
<div class="filters" id="filters"></div><div class="count" id="count"></div><div class="countries" id="countries"></div>
<div class="selectedbox"><small>Selected country</small><div class="selectedname" id="selected">🇳🇬 Nigeria</div></div>
<button class="connect" id="connect">Connect</button><div class="notice" id="notice">This is the first website prototype. It does not yet create a VPN connection. A real server in the selected country and a secure connection setup are required before Connect can work.</div>
<p class="note">Privacy note: this demo runs locally in your browser and does not ask for passwords, VPN keys, or payment details.</p></section><div class="foot">Freedom VPN · Prototype · 114 country options</div></main>
<script>
const allCountries = [{"code": "DZ", "name": "Algeria", "region": "Africa"}, {"code": "AO", "name": "Angola", "region": "Africa"}, {"code": "BJ", "name": "Benin", "region": "Africa"}, {"code": "BW", "name": "Botswana", "region": "Africa"}, {"code": "BF", "name": "Burkina Faso", "region": "Africa"}, {"code": "BI", "name": "Burundi", "region": "Africa"}, {"code": "CV", "name": "Cabo Verde", "region": "Africa"}, {"code": "CM", "name": "Cameroon", "region": "Africa"}, {"code": "CF", "name": "Central African Republic", "region": "Africa"}, {"code": "TD", "name": "Chad", "region": "Africa"}, {"code": "KM", "name": "Comoros", "region": "Africa"}, {"code": "CG", "name": "Republic of the Congo", "region": "Africa"}, {"code": "CD", "name": "Democratic Republic of the Congo", "region": "Africa"}, {"code": "CI", "name": "Côte d’Ivoire", "region": "Africa"}, {"code": "DJ", "name": "Djibouti", "region": "Africa"}, {"code": "EG", "name": "Egypt", "region": "Africa"}, {"code": "GQ", "name": "Equatorial Guinea", "region": "Africa"}, {"code": "ER", "name": "Eritrea", "region": "Africa"}, {"code": "SZ", "name": "Eswatini", "region": "Africa"}, {"code": "ET", "name": "Ethiopia", "region": "Africa"}, {"code": "GA", "name": "Gabon", "region": "Africa"}, {"code": "GM", "name": "The Gambia", "region": "Africa"}, {"code": "GH", "name": "Ghana", "region": "Africa"}, {"code": "GN", "name": "Guinea", "region": "Africa"}, {"code": "GW", "name": "Guinea-Bissau", "region": "Africa"}, {"code": "KE", "name": "Kenya", "region": "Africa"}, {"code": "LS", "name": "Lesotho", "region": "Africa"}, {"code": "LR", "name": "Liberia", "region": "Africa"}, {"code": "LY", "name": "Libya", "region": "Africa"}, {"code": "MG", "name": "Madagascar", "region": "Africa"}, {"code": "MW", "name": "Malawi", "region": "Africa"}, {"code": "ML", "name": "Mali", "region": "Africa"}, {"code": "MR", "name": "Mauritania", "region": "Africa"}, {"code": "MU", "name": "Mauritius", "region": "Africa"}, {"code": "MA", "name": "Morocco", "region": "Africa"}, {"code": "MZ", "name": "Mozambique", "region": "Africa"}, {"code": "NA", "name": "Namibia", "region": "Africa"}, {"code": "NE", "name": "Niger", "region": "Africa"}, {"code": "NG", "name": "Nigeria", "region": "Africa"}, {"code": "RW", "name": "Rwanda", "region": "Africa"}, {"code": "ST", "name": "São Tomé and Príncipe", "region": "Africa"}, {"code": "SN", "name": "Senegal", "region": "Africa"}, {"code": "SC", "name": "Seychelles", "region": "Africa"}, {"code": "SL", "name": "Sierra Leone", "region": "Africa"}, {"code": "SO", "name": "Somalia", "region": "Africa"}, {"code": "ZA", "name": "South Africa", "region": "Africa"}, {"code": "SS", "name": "South Sudan", "region": "Africa"}, {"code": "SD", "name": "Sudan", "region": "Africa"}, {"code": "TZ", "name": "Tanzania", "region": "Africa"}, {"code": "TG", "name": "Togo", "region": "Africa"}, {"code": "TN", "name": "Tunisia", "region": "Africa"}, {"code": "UG", "name": "Uganda", "region": "Africa"}, {"code": "ZM", "name": "Zambia", "region": "Africa"}, {"code": "ZW", "name": "Zimbabwe", "region": "Africa"}, {"code": "AL", "name": "Albania", "region": "Europe"}, {"code": "AD", "name": "Andorra", "region": "Europe"}, {"code": "AT", "name": "Austria", "region": "Europe"}, {"code": "BE", "name": "Belgium", "region": "Europe"}, {"code": "BA", "name": "Bosnia and Herzegovina", "region": "Europe"}, {"code": "BG", "name": "Bulgaria", "region": "Europe"}, {"code": "HR", "name": "Croatia", "region": "Europe"}, {"code": "CY", "name": "Cyprus", "region": "Europe"}, {"code": "CZ", "name": "Czechia", "region": "Europe"}, {"code": "DK", "name": "Denmark", "region": "Europe"}, {"code": "EE", "name": "Estonia", "region": "Europe"}, {"code": "FI", "name": "Finland", "region": "Europe"}, {"code": "FR", "name": "France", "region": "Europe"}, {"code": "DE", "name": "Germany", "region": "Europe"}, {"code": "GR", "name": "Greece", "region": "Europe"}, {"code": "HU", "name": "Hungary", "region": "Europe"}, {"code": "IS", "name": "Iceland", "region": "Europe"}, {"code": "IE", "name": "Ireland", "region": "Europe"}, {"code": "IT", "name": "Italy", "region": "Europe"}, {"code": "LV", "name": "Latvia", "region": "Europe"}, {"code": "LT", "name": "Lithuania", "region": "Europe"}, {"code": "LU", "name": "Luxembourg", "region": "Europe"}, {"code": "MT", "name": "Malta", "region": "Europe"}, {"code": "MD", "name": "Moldova", "region": "Europe"}, {"code": "MC", "name": "Monaco", "region": "Europe"}, {"code": "ME", "name": "Montenegro", "region": "Europe"}, {"code": "NL", "name": "Netherlands", "region": "Europe"}, {"code": "MK", "name": "North Macedonia", "region": "Europe"}, {"code": "NO", "name": "Norway", "region": "Europe"}, {"code": "PL", "name": "Poland", "region": "Europe"}, {"code": "PT", "name": "Portugal", "region": "Europe"}, {"code": "RO", "name": "Romania", "region": "Europe"}, {"code": "RS", "name": "Serbia", "region": "Europe"}, {"code": "SK", "name": "Slovakia", "region": "Europe"}, {"code": "SI", "name": "Slovenia", "region": "Europe"}, {"code": "ES", "name": "Spain", "region": "Europe"}, {"code": "SE", "name": "Sweden", "region": "Europe"}, {"code": "CH", "name": "Switzerland", "region": "Europe"}, {"code": "UA", "name": "Ukraine", "region": "Europe"}, {"code": "GB", "name": "United Kingdom", "region": "Europe"}, {"code": "US", "name": "United States", "region": "Americas"}, {"code": "CA", "name": "Canada", "region": "Americas"}, {"code": "MX", "name": "Mexico", "region": "Americas"}, {"code": "BR", "name": "Brazil", "region": "Americas"}, {"code": "AR", "name": "Argentina", "region": "Americas"}, {"code": "CL", "name": "Chile", "region": "Americas"}, {"code": "CO", "name": "Colombia", "region": "Americas"}, {"code": "PE", "name": "Peru", "region": "Americas"}, {"code": "AU", "name": "Australia", "region": "Asia-Pacific"}, {"code": "NZ", "name": "New Zealand", "region": "Asia-Pacific"}, {"code": "JP", "name": "Japan", "region": "Asia-Pacific"}, {"code": "SG", "name": "Singapore", "region": "Asia-Pacific"}, {"code": "IN", "name": "India", "region": "Asia-Pacific"}, {"code": "KR", "name": "South Korea", "region": "Asia-Pacific"}, {"code": "MY", "name": "Malaysia", "region": "Asia-Pacific"}, {"code": "TH", "name": "Thailand", "region": "Asia-Pacific"}, {"code": "ID", "name": "Indonesia", "region": "Asia-Pacific"}, {"code": "PH", "name": "Philippines", "region": "Asia-Pacific"}, {"code": "AE", "name": "United Arab Emirates", "region": "Middle East"}, {"code": "TR", "name": "Türkiye", "region": "Middle East"}];
const flag = code => [...code.toUpperCase()].map(ch=>String.fromCodePoint(127397+ch.charCodeAt(0))).join('');
const regions=['All','Africa','Europe','Americas','Asia-Pacific','Middle East'];
let activeRegion='All', selected='NG';
const filters=document.getElementById('filters'), list=document.getElementById('countries'), search=document.getElementById('search');
regions.forEach(r=>{const b=document.createElement('button');b.className='filter'+(r===activeRegion?' active':'');b.textContent=r;b.onclick=()=>{activeRegion=r;document.querySelectorAll('.filter').forEach(x=>x.classList.toggle('active',x.textContent===r));render()};filters.appendChild(b)});
function render(){const q=search.value.trim().toLowerCase();const rows=allCountries.filter(c=>(activeRegion==='All'||c.region===activeRegion)&&(c.name.toLowerCase().includes(q)||c.code.toLowerCase()===q));document.getElementById('count').textContent=`${rows.length} countries shown · ${allCountries.length} listed`;list.innerHTML='';rows.forEach(c=>{const b=document.createElement('button');b.className='country'+(selected===c.code?' selected':'');b.innerHTML=`<span class="flag">${flag(c.code)}</span><span style="min-width:0"><span class="cname">${c.name}</span><span class="region">${c.region}</span></span><span class="tick">✓</span>`;b.onclick=()=>{selected=c.code;document.getElementById('selected').textContent=flag(c.code)+' '+c.name;render()};list.appendChild(b)});if(!rows.length)list.innerHTML='<p style="color:#9fb0c8">No countries found. Try another search.</p>'}
search.addEventListener('input',render);document.getElementById('connect').onclick=()=>{const c=allCountries.find(x=>x.code===selected);const n=document.getElementById('notice');n.textContent=`${c.name} is selected, but no VPN server is configured there yet. This prototype does not route internet traffic. The next step is to set up a real VPN server and connect it securely.`;n.style.display='block'};
render();
</script></body></html>
